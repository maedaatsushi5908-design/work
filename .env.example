# ============================================================
# kenmo スキャナー 通知設定
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# ── LINE Messaging API ──────────────────────────────────────
# 手順: https://developers.line.biz/console/ でプロバイダー作成
#   → Messaging API チャンネル作成
#   → チャンネルアクセストークン（長期）を発行
#   → ユーザーIDは LINE アプリ「プロフィール」→「自分のID」で確認
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ── Discord Webhook ─────────────────────────────────────────
# 手順: サーバー設定 → 連携サービス → ウェブフック → 新しいウェブフック
#   → ウェブフックURLをコピー
DISCORD_WEBHOOK_URL=

# ── Slack Incoming Webhook ──────────────────────────────────
# 手順: api.slack.com/apps → Create New App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Gmail (メール通知) ──────────────────────────────────────
# Gmailの場合: Googleアカウント → セキュリティ → アプリパスワードを生成
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_TO=destination@example.com
