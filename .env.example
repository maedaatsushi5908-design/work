# ============================================================
# kenmo スキャナー 通知設定
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# ── LINE Messaging API ──────────────────────────────────────
# 手順: https://developers.line.biz/console/ でプロバイダー作成
#   → Messaging API チャンネル作成
#   → チャンネルアクセストークン（長期）を発行
#   → ユーザーIDは LINE アプリ「プロフィール」→「自分のID」で確認
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ── Discord Webhook ─────────────────────────────────────────
# 手順: サーバー設定 → 連携サービス → ウェブフック → 新しいウェブフック
#   → ウェブフックURLをコピー
DISCORD_WEBHOOK_URL=

# ── Slack Incoming Webhook ──────────────────────────────────
# 手順: api.slack.com/apps → Create New App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Gmail (メール通知) ──────────────────────────────────────
# Gmailの場合: Googleアカウント → セキュリティ → アプリパスワードを生成
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_TO=destination@example.com

# ── e-Stat 政府統計API (external_signals.py 用・任意) ────────
# 建設工事受注動態統計・商業動態統計などを取得するのに使う。
# 未設定でも external_signals.py は動作する（政府統計だけがスキップされる）。
# 手順: https://www.e-stat.go.jp/api/ でユーザー登録
#   → マイページ → アプリケーションID発行（無料・即日）
ESTAT_APP_ID=
